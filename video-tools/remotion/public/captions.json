[{"start": 0.0, "end": 1.421, "text": "“Yaklaşık 50 bin lira"}, {"start": 1.421, "end": 2.86, "text": "sermayeyle başlayarak…”"}, {"start": 3.1, "end": 5.077, "text": "GUMA’nın ilk videosunda açıklanan"}, {"start": 5.077, "end": 6.0, "text": "bütçe planı bu."}, {"start": 6.36, "end": 7.325, "text": "Ama aynı videoda"}, {"start": 7.325, "end": 8.7, "text": "başka bir sayı daha var:"}, {"start": 8.96, "end": 9.76, "text": "130 bin."}, {"start": 10.1, "end": 10.88, "text": "Para değil."}, {"start": 11.08, "end": 11.84, "text": "Takipçi."}, {"start": 12.18, "end": 13.62, "text": "Videoyu anlatan kurucu,"}, {"start": 13.62, "end": 15.426, "text": "daha önce 130 bin takipçiye"}, {"start": 15.426, "end": 16.68, "text": "ulaştığını söylüyor."}]
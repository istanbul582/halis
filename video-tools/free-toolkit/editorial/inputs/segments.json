[
  {
    "start": 0.0,
    "end": 1.421,
    "text": "“Yaklaşık 50 bin lira"
  },
  {
    "start": 1.421,
    "end": 2.86,
    "text": "sermayeyle başlayarak…”"
  },
  {
    "start": 3.1,
    "end": 5.077,
    "text": "GUMA’nın ilk videosunda açıklanan"
  },
  {
    "start": 5.077,
    "end": 6.0,
    "text": "bütçe planı bu."
  },
  {
    "start": 6.36,
    "end": 7.325,
    "text": "Ama aynı videoda"
  },
  {
    "start": 7.325,
    "end": 8.7,
    "text": "başka bir sayı daha var:"
  },
  {
    "start": 8.96,
    "end": 9.76,
    "text": "130 bin."
  },
  {
    "start": 10.1,
    "end": 10.88,
    "text": "Para değil."
  },
  {
    "start": 11.08,
    "end": 11.84,
    "text": "Takipçi."
  },
  {
    "start": 12.18,
    "end": 13.62,
    "text": "Videoyu anlatan kurucu,"
  },
  {
    "start": 13.62,
    "end": 15.426,
    "text": "daha önce 130 bin takipçiye"
  },
  {
    "start": 15.426,
    "end": 16.68,
    "text": "ulaştığını söylüyor."
  },
  {
    "start": 17.02,
    "end": 19.76,
    "text": "Yani markalaşma hikâyesini\ndeğerlendirirken"
  },
  {
    "start": 19.76,
    "end": 21.622,
    "text": "yalnızca başlangıç bütçesine"
  },
  {
    "start": 21.622,
    "end": 22.8,
    "text": "bakmak yeterli mi?"
  },
  {
    "start": 23.04,
    "end": 25.23,
    "text": "Çünkü bir ürünü tasarlamak bir iş."
  },
  {
    "start": 25.23,
    "end": 26.949,
    "text": "O ürünü insanlara duyurmak"
  },
  {
    "start": 26.949,
    "end": 27.8,
    "text": "başka bir iş."
  },
  {
    "start": 28.0,
    "end": 30.92,
    "text": "Önceden oluşturduğun bir\nizleyici kitlesi varsa,"
  },
  {
    "start": 30.92,
    "end": 32.376,
    "text": "hikâyeni anlatabileceğin"
  },
  {
    "start": 32.376,
    "end": 33.55,
    "text": "bir kanalın da var."
  },
  {
    "start": 34.01,
    "end": 35.39,
    "text": "Bir de üretim tarafı var."
  },
  {
    "start": 35.75,
    "end": 37.797,
    "text": "GUMA’nın kendi\nkullanım koşullarında,"
  },
  {
    "start": 37.797,
    "end": 40.47,
    "text": "ürünlerin Saloni Mobilya\ntarafından üretildiği"
  },
  {
    "start": 40.47,
    "end": 42.68,
    "text": "ve GUMA aracılığıyla\nsatıldığı yazıyor."
  },
  {
    "start": 43.07,
    "end": 45.283,
    "text": "Hatta şirket, Saloni için doğrudan"
  },
  {
    "start": 45.283,
    "end": 47.92,
    "text": "“bünyesinde bulunduğu”\nifadesini kullanıyor."
  },
  {
    "start": 48.4,
    "end": 50.122,
    "text": "Kurucu Yavuz Selim Bayraktar’ın"
  },
  {
    "start": 50.122,
    "end": 51.975,
    "text": "gazetede yayımlanan açıklaması da"
  },
  {
    "start": 51.975,
    "end": 53.89,
    "text": "bu tabloya bir bilgi daha ekliyor:"
  },
  {
    "start": 54.33,
    "end": 55.478,
    "text": "“Dayım Haluk Özbek,"
  },
  {
    "start": 55.478,
    "end": 57.08,
    "text": "Guma’nın doğuş hikayesinde"
  },
  {
    "start": 57.08,
    "end": 58.48,
    "text": "önemli bir paya sahip.”"
  },
  {
    "start": 58.97,
    "end": 60.434,
    "text": "Haluk Özbek, aynı haberde"
  },
  {
    "start": 60.434,
    "end": 62.638,
    "text": "Saloni Mobilya\nYönetim Kurulu Başkanı"
  },
  {
    "start": 62.638,
    "end": 63.71,
    "text": "olarak tanıtılıyor."
  },
  {
    "start": 64.11,
    "end": 65.952,
    "text": "Bayraktar, dayısının bilgileriyle"
  },
  {
    "start": 65.952,
    "end": 67.691,
    "text": "mobilya sektörünü tanımalarını"
  },
  {
    "start": 67.691,
    "end": 68.92,
    "text": "sağladığını anlatıyor."
  },
  {
    "start": 69.39,
    "end": 71.27,
    "text": "Şimdi bu bilgileri birlikte düşün."
  },
  {
    "start": 71.73,
    "end": 72.981,
    "text": "Bir tarafta açıklanan"
  },
  {
    "start": 72.981,
    "end": 74.54,
    "text": "50 bin liralık bütçe planı."
  },
  {
    "start": 74.94,
    "end": 77.615,
    "text": "Diğer tarafta daha önce\nulaşıldığı söylenen"
  },
  {
    "start": 77.615,
    "end": 78.893,
    "text": "bir izleyici kitlesi,"
  },
  {
    "start": 78.893,
    "end": 80.886,
    "text": "kurucunun anlattığı aile desteği"
  },
  {
    "start": 80.886,
    "end": 83.23,
    "text": "ve şirketin açıkladığı\nüretim ilişkisi."
  },
  {
    "start": 83.64,
    "end": 86.19,
    "text": "Bunlar üretimin ücretsiz\nolduğunu göstermiyor."
  },
  {
    "start": 86.55,
    "end": 88.306,
    "text": "Fakat başlangıcı anlamak için"
  },
  {
    "start": 88.306,
    "end": 90.65,
    "text": "hesaba katılması\ngereken somut bilgiler."
  },
  {
    "start": 91.09,
    "end": 93.4,
    "text": "Bir marka kurarken\nüreticiyi bulmak,"
  },
  {
    "start": 93.4,
    "end": 95.793,
    "text": "numuneyi hazırlatmak,\nmalzemeyi seçmek,"
  },
  {
    "start": 95.793,
    "end": 96.947,
    "text": "ürünü tanıtmak ve"
  },
  {
    "start": 96.947,
    "end": 98.98,
    "text": "ilk müşteriye ulaşmak gerekiyor."
  },
  {
    "start": 99.41,
    "end": 101.192,
    "text": "Başlangıç koşullarını konuşmak,"
  },
  {
    "start": 101.192,
    "end": 103.653,
    "text": "bu işlerin hangilerini\nnasıl çözebildiğini"
  },
  {
    "start": 103.653,
    "end": 104.54,
    "text": "konuşmak demek."
  },
  {
    "start": 104.96,
    "end": 108.267,
    "text": "GUMA örneğinde tasarım ve\npazarlama emeğiyle birlikte,"
  },
  {
    "start": 108.267,
    "end": 110.5,
    "text": "açıklanan bu ilişkileri\nde görüyoruz."
  },
  {
    "start": 110.92,
    "end": 112.541,
    "text": "Hikâyeyi öğretici yapan şey,"
  },
  {
    "start": 112.541,
    "end": 115.28,
    "text": "bunların nasıl bir araya\ngeldiğini anlayabilmek."
  },
  {
    "start": 115.69,
    "end": 118.519,
    "text": "Çünkü kendi işini\nkurmak isteyen biri için"
  },
  {
    "start": 118.519,
    "end": 120.569,
    "text": "yalnızca “Kaç lirayla başladılar?”"
  },
  {
    "start": 120.569,
    "end": 122.12,
    "text": "sorusunun cevabı yetmez."
  },
  {
    "start": 122.51,
    "end": 124.45,
    "text": "O bütçeyle hangi işleri yaptılar?"
  },
  {
    "start": 124.73,
    "end": 126.65,
    "text": "Hangi imkânlara erişebiliyorlardı?"
  },
  {
    "start": 127.02,
    "end": 128.457,
    "text": "Sen aynı işe başlasan,"
  },
  {
    "start": 128.457,
    "end": 130.47,
    "text": "ayrıca neleri kurman gerekecek?"
  },
  {
    "start": 130.9,
    "end": 132.167,
    "text": "İşte başlangıç rakamı,"
  },
  {
    "start": 132.167,
    "end": 134.33,
    "text": "bu sorularla birlikte\nanlam kazanıyor."
  },
  {
    "start": 134.77,
    "end": 136.93,
    "text": "Bir başarı hikâyesinden\nilham alırken,"
  },
  {
    "start": 136.93,
    "end": 139.081,
    "text": "sonucu kadar başlangıç\nkoşullarına da"
  },
  {
    "start": 139.081,
    "end": 140.05,
    "text": "bakmak gerekiyor."
  },
  {
    "start": 140.48,
    "end": 141.526,
    "text": "Böylece yalnızca"
  },
  {
    "start": 141.526,
    "end": 143.97,
    "text": "“Ben de yapabilir\nmiyim?” diye sormuyorsun."
  },
  {
    "start": 144.34,
    "end": 146.501,
    "text": "Kendi yolunda neyi\nhazırlaman gerektiğini"
  },
  {
    "start": 146.501,
    "end": 147.21,
    "text": "de görüyorsun."
  },
  {
    "start": 147.69,
    "end": 148.82,
    "text": "O yüzden sorum şu:"
  },
  {
    "start": 149.27,
    "end": 151.254,
    "text": "Aynı parayla başlayan iki insan,"
  },
  {
    "start": 151.254,
    "end": 153.45,
    "text": "gerçekten aynı\nnoktadan mı başlıyor?"
  },
  {
    "start": 153.87,
    "end": 154.94,
    "text": "Yorumlarda buluşalım."
  }
]